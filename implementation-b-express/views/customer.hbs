<div class="page-header">
  <div>
    <h1>Customer Details</h1>
    <p class="muted">{{customer.first_name}} {{customer.last_name}}</p>
  </div>
  <div class="header-actions">
    <button id="show-add-account" class="btn btn-primary">+ Add Account</button>
    <a class="btn btn-ghost" href="/customers">&larr; Back to Customers</a>
  </div>
</div>

<section class="panel">
  <div class="panel-title"><h2>Customer Information</h2></div>
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">Full Name</span>
      <span class="detail-value"><strong>{{customer.first_name}} {{customer.last_name}}</strong></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Customer Code</span>
      <span class="detail-value"><span class="code-pill">{{customer.customer_code}}</span></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Email</span>
      <span class="detail-value">{{customer.email}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Phone</span>
      <span class="detail-value">{{customer.phone}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Address</span>
      <span class="detail-value">{{#if customer.address}}{{customer.address}}{{else}}&mdash;{{/if}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">City</span>
      <span class="detail-value">{{customer.city}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Registered</span>
      <span class="detail-value">{{formatDate customer.created_at}}</span>
    </div>
  </div>
</section>

<section id="add-account-panel" class="panel hidden">
  <div class="panel-title"><h2>Open an Account</h2></div>
  <form id="add-account-form" class="form-grid" novalidate>
    <input type="hidden" name="customer_id" value="{{customer.id}}">
    <label>Account Type
      <select name="account_type" required>
        <option value="">Select type</option>
        <option value="Savings">Savings</option>
        <option value="Current">Current</option>
        <option value="Salary">Salary</option>
      </select>
    </label>
    <label>Initial Balance (₹) <input type="number" name="initial_balance" min="0" step="0.01" value="0"></label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Account</button>
      <button type="button" id="hide-add-account" class="btn btn-ghost">Cancel</button>
    </div>
    <p id="add-account-message" class="form-message" role="status"></p>
  </form>
</section>

<section class="panel">
  <div class="panel-title">
    <h2>Customer Accounts</h2>
    <span class="muted">{{customer.accounts.length}} accounts</span>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Account Number</th>
          <th>Type</th>
          <th>Balance</th>
          <th>Status</th>
          <th>Opened</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#if customer.accounts.length}}
          {{#each customer.accounts}}
            <tr>
              <td><a href="/account/{{this.account_number}}"><strong>{{this.account_number}}</strong></a></td>
              <td>{{this.account_type}}</td>
              <td class="amount {{#if (eq this.status "Active")}}credit{{/if}}">{{formatCurrency this.balance}}</td>
              <td>
                {{#if (eq this.status "Active")}}
                  <span class="badge badge-active">Active</span>
                {{else if (eq this.status "Inactive")}}
                  <span class="badge badge-inactive">Inactive</span>
                {{else}}
                  <span class="badge badge-closed">Closed</span>
                {{/if}}
              </td>
              <td>{{formatDate this.opened_at}}</td>
              <td>
                <div class="table-actions">
                  <a class="btn btn-small btn-ghost" href="/account/{{this.account_number}}">View Details</a>
                  <a class="btn btn-small btn-ghost" href="/transactions/{{this.account_number}}">Transactions</a>
                </div>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr><td colspan="6" class="empty-cell">No accounts found for this customer.</td></tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</section>